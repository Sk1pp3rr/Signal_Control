<?xml version="1.0" encoding="UTF-8"?>
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!--
        ZMIANY anty-braking (wszystkie uzasadnione geometrią sieci):

        car_aggressive: tau 0.7→1.0, minGap 1.5→2.0, decel 6.0→4.5
          Powód: tau=0.7 na Owsiana_2in (35m) przy 50km/h = fizycznie za mało miejsca
          na reakcję → SUMO wymuszał emergencyDecel=9.0.

        car_standard:   tau 1.0→1.2, minGap 2.5→2.5 (bez zmian)
          Powód: delikatne zwiększenie tau redukuje braking bez zmiany charakteru.

        car_cautious:   bez zmian (tau=1.8 był OK).

        heavy_truck: decel 3.0→3.5 (ciężarówka 15m z decel=3.0 to za słabe hamulce)
        ambulance:   tau domyślne SUMO (brak)→1.0, minGap dodany=2.0
    -->

    <vTypeDistribution id="urban_cars">
        <vType id="car_aggressive"
               vClass="passenger"
               accel="3.0"
               decel="4.5"
               emergencyDecel="9.0"
               sigma="0.2"
               tau="1.0"
               length="4.5"
               minGap="2.0"
               maxSpeed="13.89"
               color="red"
               guiShape="passenger"
               probability="0.15"/>

        <vType id="car_standard"
               vClass="passenger"
               accel="2.6"
               decel="4.5"
               emergencyDecel="9.0"
               sigma="0.4"
               tau="1.2"
               length="4.7"
               minGap="2.5"
               maxSpeed="13.89"
               color="white"
               guiShape="passenger"
               probability="0.70"/>

        <vType id="car_cautious"
               vClass="passenger"
               accel="1.5"
               decel="3.0"
               emergencyDecel="8.0"
               sigma="0.9"
               tau="1.8"
               length="4.5"
               minGap="4.0"
               maxSpeed="11.11"
               color="blue"
               guiShape="passenger"
               probability="0.15"/>
    </vTypeDistribution>

    <vType id="ev_car"
           vClass="evehicle"
           accel="4.0"
           decel="5.0"
           emergencyDecel="9.0"
           sigma="0.2"
           tau="0.9"
           length="4.2"
           minGap="2.0"
           color="0,255,0"
           guiShape="passenger/sedan"/>

    <vType id="city_bus"
           vClass="bus"
           accel="1.2"
           decel="4.0"
           emergencyDecel="8.0"
           sigma="0.05"
           tau="1.4"
           length="12.0"
           minGap="3.0"
           color="yellow"
           guiShape="bus"
           personCapacity="80"/>

    <vType id="taxi"
           vClass="taxi"
           accel="2.8"
           decel="5.0"
           emergencyDecel="9.0"
           sigma="0.3"
           tau="1.0"
           length="4.8"
           minGap="2.0"
           color="black"
           guiShape="passenger/sedan"/>

    <vType id="delivery_van"
           vClass="delivery"
           accel="2.0"
           decel="4.5"
           emergencyDecel="8.0"
           sigma="0.2"
           tau="1.3"
           length="6.5"
           minGap="2.5"
           color="orange"
           guiShape="delivery"/>

    <vType id="heavy_truck"
           vClass="truck"
           accel="0.8"
           decel="3.5"
           emergencyDecel="7.0"
           sigma="0.1"
           tau="1.6"
           length="15.0"
           minGap="4.0"
           color="77,77,77"
           guiShape="truck/semitrailer"/>

    <vType id="police"
           vClass="authority"
           accel="4.0"
           decel="6.0"
           emergencyDecel="9.0"
           sigma="0.1"
           tau="1.0"
           length="5.0"
           minGap="2.0"
           color="blue"
           guiShape="police"/>

    <vType id="ambulance"
           vClass="emergency"
           accel="3.0"
           decel="5.0"
           emergencyDecel="9.0"
           sigma="0.0"
           tau="1.0"
           length="6.0"
           minGap="2.0"
           speedFactor="normc(1.10,0.00)"
           color="white"
           guiShape="emergency"/>

    <vType id="fire_truck"
           vClass="emergency"
           accel="1.5"
           decel="4.0"
           emergencyDecel="8.0"
           sigma="0.0"
           tau="1.2"
           length="10.0"
           minGap="3.0"
           speedFactor="normc(1.00,0.00)"
           color="red"
           guiShape="firebrigade"/>

    <vType id="pedestrian_default"
           vClass="pedestrian"
           length="0.50"
           minGap="0.20"
           maxSpeed="10.44"
           guiShape="pedestrian"
           width="0.50"/>

</additional>