<?xml version="1.0" encoding="UTF-8"?>
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <vTypeDistribution id="urban_cars">
        <!-- Agresywny: podnieśliśmy tau 0.7→1.2 i minGap 1.5→2.0 — redukuje awaryjne hamowania -->
        <vType id="car_aggressive" vClass="passenger" accel="3.2" decel="5.0" emergencyDecel="9.0"
               sigma="0.1" tau="1.2" length="4.5" minGap="2.0" maxSpeed="13.89"
               color="red" guiShape="passenger" probability="0.15"/>

        <!-- Standardowy: tau 1.0→1.4, bez zmian charakteru -->
        <vType id="car_standard" vClass="passenger" accel="2.6" decel="4.5" emergencyDecel="9.0"
               sigma="0.5" tau="1.4" length="4.7" minGap="2.5" maxSpeed="13.89"
               color="white" guiShape="passenger" probability="0.70"/>

        <!-- Ostrożny: bez zmian, już był dobrze skonfigurowany -->
        <vType id="car_cautious" vClass="passenger" accel="1.5" decel="3.0" emergencyDecel="7.0"
               sigma="0.9" tau="1.8" length="4.5" minGap="4.0" maxSpeed="11.11"
               color="blue" guiShape="passenger" probability="0.15"/>
    </vTypeDistribution>

    <!-- Dodajemy alias "car" żeby flow z .rou.xml działały -->
    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" emergencyDecel="9.0"
           sigma="0.5" tau="1.4" length="4.7" minGap="2.5" maxSpeed="13.89"
           color="white" guiShape="passenger"/>

    <vType id="ev_car" vClass="evehicle" accel="4.0" decel="5.0" emergencyDecel="9.0"
           sigma="0.2" tau="1.3" length="4.2" minGap="2.0" maxSpeed="13.89"
           color="0,255,0" guiShape="passenger/sedan"/>

    <!-- city_bus: dodano tau i emergencyDecel -->
    <vType id="city_bus" vClass="bus" accel="1.2" decel="4.0" emergencyDecel="8.0"
           tau="1.6" length="12.0" minGap="3.0" maxSpeed="11.11"
           color="yellow" guiShape="bus" personCapacity="80"/>

    <vType id="taxi" vClass="taxi" accel="2.8" decel="5.0" emergencyDecel="9.0"
           tau="1.3" length="4.8" minGap="2.0" maxSpeed="13.89"
           color="black" guiShape="passenger/sedan"/>

    <vType id="delivery_van" vClass="delivery" accel="2.0" decel="4.5" emergencyDecel="8.0"
           tau="1.5" length="6.5" minGap="2.5" maxSpeed="11.11"
           color="orange" guiShape="delivery"/>

    <vType id="heavy_truck" vClass="truck" accel="0.8" decel="3.0" emergencyDecel="7.0"
           tau="1.8" length="15.0" minGap="3.5" maxSpeed="11.11"
           color="77,77,77" guiShape="truck/semitrailer"/>

    <vType id="police" vClass="authority" accel="4.0" decel="6.0" emergencyDecel="9.0"
           tau="1.2" length="5.0" minGap="2.0" maxSpeed="16.67"
           color="blue" guiShape="police"/>

    <!-- ambulance: dodano tau i emergencyDecel; speedFactor normc(1.1,0) = zawsze 1.1x -->
    <vType id="ambulance" vClass="emergency" accel="3.0" decel="5.0" emergencyDecel="9.0"
           tau="1.4" length="6.0" minGap="2.5" maxSpeed="16.67"
           speedFactor="normc(1.10,0.05,0.9,1.3)"
           guiShape="emergency" color="white"/>

    <vType id="fire_truck" vClass="emergency" accel="1.5" decel="4.0" emergencyDecel="8.0"
           tau="1.6" length="10.0" minGap="3.0" maxSpeed="13.89"
           speedFactor="normc(1.00,0.05,0.9,1.1)"
           guiShape="firebrigade" color="red"/>
    <vType id="pedestrian_default" length="0.50" minGap="0.20" maxSpeed="10.44"
           vClass="pedestrian" guiShape="pedestrian" width="0.50"/>

</additional>